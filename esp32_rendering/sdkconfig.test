CONFIG_TEST_CONSOLE_ENABLED=y
CONFIG_TEST_CONSOLE_HISTORY_LEN=32
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Route primary console to the S3's built-in USB-JTAG CDC. The
# ESP32-S3-RLCD board has no external UART-to-USB chip — UART0 pins
# aren't wired to the USB connector — so without this override the
# REPL is invisible to the host.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
